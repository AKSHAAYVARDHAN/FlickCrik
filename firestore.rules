rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /rooms/{roomId} {
      // Anyone can read rooms (needed for room sharing by code)
      allow read: if true;

      // Rooms are created by an authenticated anonymous Firebase session so we
      // can enforce host-only mutations at the rules layer.
      allow create: if request.auth != null
        && incoming().hostId == request.auth.uid
        && incoming().isActive == true
        && incoming().expiredAt == null
        && incoming().players[incoming().hostId].id == request.auth.uid;

      // Unified rule covers room membership, host transfer, team naming,
      // and match-state writes.
      // The engine sends { players, gameState, status } together,
      // while lobby controls can also update { hostId, teamNames }.
      allow update: if (
        request.auth != null
        && hostChangeIsValid()
        && playerRemovalIsValid()
        &&
        incoming().diff(existing()).affectedKeys()
          .hasOnly(['players', 'status', 'gameState', 'chat', 'hostId', 'teamNames', 'isActive', 'expiredAt'])
        && chatUnchangedOrValid()
      );
    }
  }

  function incoming() {
    return request.resource.data;
  }

  function existing() {
    return resource.data;
  }

  function chatUnchangedOrValid() {
    return !incoming().diff(existing()).affectedKeys().hasAny(['chat'])
      || (incoming().chat is list && incoming().chat.size() <= 50);
  }

  function hostChangeIsValid() {
    return !incoming().diff(existing()).affectedKeys().hasAny(['hostId'])
      || request.auth.uid == existing().hostId
      || offlineHostFailoverIsValid();
  }

  function offlineHostFailoverIsValid() {
    let existingHostId = existing().hostId;
    let nextHostId = incoming().hostId;

    return existingHostId is string
      && nextHostId is string
      && existingHostId != nextHostId
      && existing().players.keys().hasAny([request.auth.uid])
      && incoming().players.keys().hasAny([nextHostId])
      && existing().players.keys().hasAny([existingHostId])
      && (existing().players[existingHostId].lastSeen is int
        || existing().players[existingHostId].lastSeen is float)
      && request.time.toMillis() - existing().players[existingHostId].lastSeen > 30000
      && incoming().players[nextHostId].id == nextHostId
      && incoming().players[nextHostId].isBot == false
      && incoming().players[nextHostId].isOnline == true
      && incoming().players[nextHostId].isBotControlled == false;
  }

  function playerRemovalIsValid() {
    let removedPlayerIds = existing().players.diff(incoming().players).removedKeys();

    return removedPlayerIds.size() == 0
      || request.auth.uid == existing().hostId
      || (removedPlayerIds.size() == 1 && removedPlayerIds[0] == request.auth.uid);
  }
}
